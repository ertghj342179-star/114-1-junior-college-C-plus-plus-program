using System;

class Student
{
    public int id;
    public string name;
    public Student next;

    public Student(int id, string name)
    {
        this.id = id;
        this.name = name;
        this.next = null;
    }
}

class LinkedList
{
    private Student head = null;

    // 插入節點（尾端）
    public void Insert(int id, string name)
    {
        Student newNode = new Student(id, name);

        if (head == null)
        {
            head = newNode;
            return;
        }

        Student temp = head;
        while (temp.next != null)
        {
            temp = temp.next;
        }
        temp.next = newNode;
    }

    // 顯示鏈結串列
    public void Display()
    {
        Student temp = head;

        if (temp == null)
        {
            Console.WriteLine("鏈結串列為空");
            return;
        }

        Console.WriteLine("目前鏈結串列內容：");
        while (temp != null)
        {
            Console.WriteLine($"ID: {temp.id}, Name: {temp.name}");
            temp = temp.next;
        }
    }

    // 刪除指定ID
    public void Delete(int id)
    {
        Student temp = head;
        Student prev = null;

        // 找不到
        if (head == null)
        {
            Console.WriteLine("找不到資料");
            return;
        }

        // 刪除頭節點
        if (head.id == id)
        {
            head = head.next;
            Console.WriteLine("刪除成功");
            return;
        }

        // 找節點
        while (temp != null && temp.id != id)
        {
            prev = temp;
            temp = temp.next;
        }

        // 沒找到
        if (temp == null)
        {
            Console.WriteLine("找不到資料");
            return;
        }

        // 刪除節點
        prev.next = temp.next;
        Console.WriteLine("刪除成功");
    }
}

class Program
{
    static void Main()
    {
        LinkedList list = new LinkedList();

        // === 題目1：新增資料 ===
        list.Insert(101, "小明");
        list.Insert(102, "小華");
        list.Insert(103, "小美");

        list.Display();

        // === 題目2：刪除 ===
        Console.Write("輸入要刪除的學生ID：");
        int id = int.Parse(Console.ReadLine());

        list.Delete(id);

        // 顯示刪除後結果
        list.Display();
    }
}
